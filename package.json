{
  "name": "@skipstery/inline-measure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./multiline": {
      "types": "./dist/multiline.d.ts",
      "import": "./dist/multiline.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json",
    "typecheck:fast": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest --config vitest.config.ts run",
    "test:run": "vitest --config vitest.config.ts run src"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "happy-dom": "20.11.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "vite": "8.2.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@testing-library/react": "16.3.2",
    "@vitejs/plugin-react": "6.1.0"
  },
  "dependencies": {
    "linebreak": "1.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skipstery/ui.git",
    "directory": "packages/inline-measure"
  }
}
