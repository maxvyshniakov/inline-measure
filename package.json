{
  "name": "@maxvyshniakov/inline-measure",
  "version": "0.2.1",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "description": "Browser text measurement without React or design-system dependencies.",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./multiline": {
      "types": "./dist/multiline.d.ts",
      "import": "./dist/multiline.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "prepare": "repo-kit hooks install",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "verify": "repo-kit verify",
    "release": "repo-kit release",
    "release:publish": "repo-kit publish",
    "check:changelogs": "repo-kit check-changelogs",
    "check:kit": "repo-kit check",
    "check:consumer": "repo-kit packed-consumer",
    "security:tls": "repo-kit tls",
    "lint": "oxlint --config .oxlintrc.json --max-warnings=0 src repo-kit.config.mjs",
    "test": "vitest --config vitest.config.ts run",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json",
    "typecheck:fast": "tsc --noEmit -p tsconfig.build.json"
  },
  "devDependencies": {
    "@maxvyshniakov/repo-kit": "0.2.1",
    "@types/node": "26.6.3",
    "happy-dom": "20.14.5",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "linebreak": "^1.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxvyshniakov/inline-measure.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
