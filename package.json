{
  "name": "inline-measure",
  "version": "0.5.1",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.4",
  "description": "Browser text measurement without React or design-system dependencies.",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./multiline": {
      "types": "./dist/multiline.d.ts",
      "import": "./dist/multiline.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "prepare": "package-kit hooks install",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "verify": "package-kit verify",
    "release": "package-kit release",
    "release:publish": "package-kit publish",
    "check:changelogs": "package-kit check-changelogs",
    "check:kit": "package-kit check",
    "check:consumer": "package-kit packed-consumer",
    "lint": "oxlint --config .oxlintrc.json --max-warnings=0 src scripts package-kit.config.mjs",
    "test": "vitest --config vitest.config.ts run",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json",
    "typecheck:fast": "tsc --noEmit -p tsconfig.build.json",
    "perf": "package-kit heavy all node scripts/perf/run.mjs",
    "verify:browser": "package-kit heavy 1 node scripts/perf/run.mjs --correctness",
    "test:perf": "package-kit heavy 1 vitest --config vitest.config.ts run scripts/perf/report.test.ts",
    "perf:capture": "bun run perf",
    "perf:report": "node scripts/perf/print-report.mjs",
    "perf:test": "bun run test:perf",
    "verify:fonts": "package-kit heavy 1 node scripts/perf/font-check.mjs",
    "verify:boxes": "package-kit heavy 1 node scripts/perf/inline-box-check.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@maxvyshniakov/package-kit": "1.0.1",
    "@types/node": "26.6.3",
    "happy-dom": "20.14.5",
    "oxlint": "1.86.0",
    "playwright": "^1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "linebreak": "^1.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxvyshniakov/inline-measure.git"
  }
}
