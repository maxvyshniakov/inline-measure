{
  "name": "@skipstery/inline-measure",
  "version": "0.1.1",
  "type": "module",
  "description": "Browser text measurement without React or design-system dependencies.",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./multiline": {
      "types": "./dist/multiline.d.ts",
      "import": "./dist/multiline.js"
    }
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "verify": "node scripts/verify.mjs",
    "release": "node scripts/release.mjs",
    "release:publish": "node scripts/publish.mjs",
    "check:changelogs": "node scripts/check-changelogs.mjs",
    "check:consumer": "node scripts/check-packed-consumer.mjs",
    "lint": "oxlint --config .oxlintrc.json --max-warnings=0 src scripts",
    "test": "node --test scripts/test-scripts.mjs && vitest --config vitest.config.ts run",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json",
    "typecheck:fast": "tsc --noEmit -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "happy-dom": "20.14.5",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "linebreak": "1.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skipstery/inline-measure.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
